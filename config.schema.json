{
  "pluginAlias": "InnovaLocal",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Innova Local",
        "required": true
      },
      "devices": {
        "title": "Fancoils",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Display Name",
              "type": "string"
            },
            "host": {
              "title": "IP Address",
              "type": "string",
              "required": true,
              "placeholder": "192.168.1.50"
            }
          }
        }
      },
      "pollInterval": {
        "title": "Background polling interval (ms)",
        "type": "integer",
        "default": 10000,
        "minimum": 5000
      },
      "timeoutMs": {
        "title": "Request timeout (ms)",
        "type": "integer",
        "default": 2500,
        "minimum": 500
      },
      "retries": {
        "title": "Network retries",
        "type": "integer",
        "default": 2,
        "minimum": 0,
        "maximum": 5
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "devices",
      "type": "array",
      "orderable": true,
      "buttonText": "Add fancoil"
    },
    "pollInterval",
    "timeoutMs",
    "retries"
  ]
}
